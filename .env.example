# Copy to .env and replace every placeholder. NEVER commit .env.
# Use letters and digits only in POSTGRES_PASSWORD (it is embedded in a URL).
POSTGRES_DB=school
POSTGRES_USER=school
POSTGRES_PASSWORD=replace-with-long-random-alnum
JWT_SECRET=replace-with-at-least-32-random-characters
SEED_PASSWORD=replace-with-demo-password
SEED_ON_START=true
LOG_LEVEL=INFO
APP_TAG=dev
HTTPS_PORT=8443
HTTP_PORT=8080
SITE_ADDRESS=localhost
